# API Gateway interno de CollaBoard (solo en red `app`, sin puertos al host ni TLS):
#  - :80   recibe peticiones /api/* y /ws/* desde el Reverse Proxy (rate-limit por IP real del cliente).
#  - :${GATEWAY_INTERNAL_PORT} (8081) recibe peticiones internas desde web-ssr (BFF, sin rate-limit).

server {
  listen 80 default_server;
  server_name _;
  access_log /dev/stdout collaboard;
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};

  # Rate-limit usando la IP real del cliente propagada por el Reverse Proxy (X-Real-IP)
  set $rl_key $gw_client_ip;
  add_header X-Request-ID $collaboard_request_id always;
  add_header Retry-After  $gw_retry_after always;
  add_header Allow        $gw_allow_header always;

  include /etc/nginx/conf.d/snippets/error-pages.conf;
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  include /etc/nginx/conf.d/snippets/api-routes.conf;

  location / {
    return 404;
  }
}

server {
  listen ${GATEWAY_INTERNAL_PORT};
  server_name _;
  access_log /dev/stdout collaboard;
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};

  set $rl_key "";
  add_header X-Request-ID $collaboard_request_id always;
  add_header Allow        $gw_allow_header always;

  include /etc/nginx/conf.d/snippets/error-pages.conf;
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  include /etc/nginx/conf.d/snippets/api-routes.conf;

  location / {
    default_type application/json;
    return 404 '{"detail":"Ruta interna no publicada"}';
  }
}
