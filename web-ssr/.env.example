# Web SSR — variables de entorno (se leen en tiempo de ejecución, no al compilar).

# URL interna del API Gateway. El servidor SSR y el BFF solo llaman rutas /api/*.
#   Docker Compose: http://gateway  ·  Local con el gateway de desarrollo: http://localhost:8088
GATEWAY_INTERNAL_URL=http://localhost:8088

# Tiempo máximo (ms) de cada llamada del servidor al gateway.
GATEWAY_TIMEOUT_MS=8000

# true solo detrás de HTTPS. En http://localhost debe ser false o la cookie no se guarda.
SESSION_COOKIE_SECURE=false

# Base ws(s):// para los WebSocket del navegador. Vacío = mismo origen que la página
# (lo normal detrás del gateway). En `npm run dev` (puerto 3100) usa ws://localhost:8088.
PUBLIC_WS_URL=

# Enlace a Pixels en la barra superior. Vacío lo oculta.
PUBLIC_PIXELS_URL=http://localhost:3000

# Orígenes extra aceptados por el BFF para POST/PATCH/DELETE (separados por coma).
# En desarrollo con `npm run dev` detrás del gateway no hace falta.
BFF_ALLOWED_ORIGINS=
