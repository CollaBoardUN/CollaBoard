# Copia este archivo como .env (cp .env.example .env). Valores SOLO de desarrollo:
# cambia todas las contraseñas y JWT_SECRET fuera de tu máquina. Evita los
# caracteres  " \ | &  en las contraseñas de RabbitMQ (se insertan en JSON/sed).

# Servicios reales del prototipo 2: API de notificaciones y trabajador C#.
COMPOSE_FILE=docker-compose.yml:notifications-module/compose.gateway.yml
COMPOSE_PATH_SEPARATOR=:

# --- Acceso público -----------------------------------------------------------
GATEWAY_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088
CHAT_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
SESSION_COOKIE_SECURE=false
# Enlace a la UI de Pixels en la barra web (perfil pixels-ui). Vacío = oculto.
PUBLIC_PIXELS_URL=http://localhost:3000
BFF_ALLOWED_ORIGINS=
# Consola de RabbitMQ: 127.0.0.1 = solo esta máquina.
RABBITMQ_CONSOLE_BIND=127.0.0.1

# --- Seguridad compartida -----------------------------------------------------
# Mínimo 32 caracteres; la usan Auth, Colaboración, Pizarra y Chat.
JWT_SECRET=clave-de-desarrollo-cambiala-en-produccion-32b
NOTIFICATIONS_SERVICE_TOKEN=token-de-servicio-solo-desarrollo

# --- Gateway (ajustar cuando cambien puertos/rutas de otros servicios) -------
GATEWAY_INTERNAL_PORT=8081
# on = el gateway añade ?token= SOLO hacia Pizarra (transición); off = no lo añade.
PIZARRA_WS_TOKEN_QUERY=on
CHAT_API_UPSTREAM=chat-api:8090
NOTIFICATION_API_UPSTREAM=notification-api:8080
NOTIFICATION_API_PATH_PREFIX=/api/notifications
RATE_LIMIT_API=30r/s
RATE_LIMIT_API_BURST=60
RATE_LIMIT_AUTH=5r/s
RATE_LIMIT_AUTH_BURST=10

# --- PostgreSQL (una instancia por dominio) ----------------------------------
USER_DB_USER=auth
USER_DB_PASSWORD=dev-user-db-password
USER_DB_NAME=userdb
BOARD_DB_USER=collab
BOARD_DB_PASSWORD=dev-board-db-password
BOARD_DB_NAME=boarddb
CANVAS_DB_USER=canvas
CANVAS_DB_PASSWORD=dev-canvas-db-password
CANVAS_DB_NAME=canvasdb
NOTIFICATION_DB_USER=notif
NOTIFICATION_DB_PASSWORD=dev-notification-db-password
NOTIFICATION_DB_NAME=notificationdb

# --- MongoDB: dos bases con credenciales separadas ---------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=dev-mongo-root-password
PIXELS_MONGO_USER=pixels
PIXELS_MONGO_PASSWORD=dev-pixels-mongo-password
CHAT_MONGO_USER=chat
CHAT_MONGO_PASSWORD=dev-chat-mongo-password

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_ADMIN_USER=collaboard_admin
RABBITMQ_ADMIN_PASSWORD=dev-rabbit-admin-password
RABBITMQ_NOTIFICATION_API_USER=notification_api
RABBITMQ_NOTIFICATION_API_PASSWORD=dev-rabbit-notification-api
RABBITMQ_MESSAGE_WORKER_USER=message_worker
RABBITMQ_MESSAGE_WORKER_PASSWORD=dev-rabbit-message-worker
RABBITMQ_VHOST=collaboard
# Nombres por defecto; el definitivo lo decide Cristian (ver docs/p2-pendientes-coordinacion.md).
RABBITMQ_EVENTS_EXCHANGE=notifications.events
RABBITMQ_TASKS_QUEUE=notifications.tasks
RABBITMQ_TASKS_ROUTING_KEY=notification.task
RABBITMQ_DLX=notifications.dlx
RABBITMQ_DLQ=notifications.tasks.dlq
RABBITMQ_DLQ_ROUTING_KEY=notifications.failed
# Entregas máximas antes de enviar el mensaje a la DLQ.
RABBITMQ_MAX_DELIVERIES=3

COMPOSE_PROFILES=pixels-ui
