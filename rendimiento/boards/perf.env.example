# run.ps1 replaces each __GENERATE__ independently and stores the file under .local/.
# Keep the generated values with the corresponding collaboard-perf volumes.
PUBLIC_ORIGIN=https://gateway
PUBLIC_PIXELS_URL=https://gateway/pixels/
CHAT_ALLOWED_ORIGINS=https://gateway
SESSION_COOKIE_SECURE=true
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,gateway
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_SECRET=__GENERATE__
NOTIFICATIONS_SERVICE_TOKEN=__GENERATE__
BOARDS_PASSWORD=__GENERATE__

USER_DB_USER=perf_auth
USER_DB_NAME=perf_users
USER_DB_PASSWORD=__GENERATE__
BOARD_DB_USER=perf_board
BOARD_DB_NAME=perf_boards
BOARD_DB_PASSWORD=__GENERATE__
CANVAS_DB_USER=perf_canvas
CANVAS_DB_NAME=perf_canvas
CANVAS_DB_PASSWORD=__GENERATE__
NOTIFICATION_DB_USER=perf_notification
NOTIFICATION_DB_NAME=perf_notifications
NOTIFICATION_DB_PASSWORD=__GENERATE__

MONGO_ROOT_USER=perf_root
MONGO_ROOT_PASSWORD=__GENERATE__
PIXELS_MONGO_USER=perf_pixels
PIXELS_MONGO_PASSWORD=__GENERATE__
CHAT_MONGO_USER=perf_chat
CHAT_MONGO_PASSWORD=__GENERATE__

RABBITMQ_ADMIN_USER=perf_admin
RABBITMQ_ADMIN_PASSWORD=__GENERATE__
RABBITMQ_NOTIFICATION_API_USER=perf_notification
RABBITMQ_NOTIFICATION_API_PASSWORD=__GENERATE__
RABBITMQ_MESSAGE_WORKER_USER=perf_message
RABBITMQ_MESSAGE_WORKER_PASSWORD=__GENERATE__
