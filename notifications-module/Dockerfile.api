FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/Notification.Shared/Notification.Shared.csproj src/Notification.Shared/
COPY src/Notification.Api/Notification.Api.csproj src/Notification.Api/
RUN dotnet restore src/Notification.Api/Notification.Api.csproj
COPY src/ src/
RUN dotnet publish src/Notification.Api/Notification.Api.csproj -c Release --no-restore -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_URLS=http://+:8080
USER $APP_UID
ENTRYPOINT ["dotnet", "Notification.Api.dll"]
