# Agrega estas variables al .env de la RAÍZ del repositorio.
# Usa secretos aleatorios diferentes para cada valor; nunca hagas commit de .env.
NOTIFICATION_DB_PASSWORD=reemplazar-por-una-clave-aleatoria
RABBITMQ_PASSWORD=reemplazar-por-una-clave-aleatoria
NOTIFICATIONS_SERVICE_TOKEN=reemplazar-por-un-token-aleatorio-de-32-bytes
# JWT_SECRET debe ser EXACTAMENTE la misma que ya usa authentication-module.
